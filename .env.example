# ==========================================
# AICTE FDR Portal - Environment Configuration
# ==========================================

# ------------------------------------------
# Next.js / Frontend Configuration
# ------------------------------------------
# Public Supabase URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Public Supabase Anon/Publishable Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Supabase Server-Only Secret Key (NEVER expose to browser / NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Python AI Microservice URL (called server-to-server from Next.js API/actions)
AI_SERVICE_URL=http://127.0.0.1:8000
# Internal shared secret for Next.js <-> FastAPI service-to-service communication
AI_SERVICE_API_KEY=development_secure_internal_ai_token_key_32chars

# ------------------------------------------
# Python FastAPI AI Service Configuration
# ------------------------------------------
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
FASTAPI_ENV=development
FASTAPI_SECRET_KEY=development_secure_internal_ai_token_key_32chars

# Supabase credentials for background async job status writes (Server-to-DB)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# OCR configuration
TESSERACT_CMD=/opt/homebrew/bin/tesseract
